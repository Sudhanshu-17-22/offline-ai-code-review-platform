{
    "name": "offline-ai-code-review-platform",
    "private": true,
    "scripts": {
        "install:all": "cd server && npm install && cd ../client && npm install",
        "dev:server": "cd server && npm run dev",
        "dev:client": "cd client && npm run dev",
        "test:server": "cd server && npm test",
        "test:client": "cd client && npm test",
        "test:all": "npm run test:server && npm run test:client",
        "coverage:server": "cd server && npm run test:coverage",
        "coverage:client": "cd client && npm run test:coverage",
        "coverage:all": "npm run coverage:server && npm run coverage:client"
    },
    "dependencies": {
        "express-rate-limit": "^8.6.2"
    }
}
